<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>FireBird Config Tool</AssemblyName>
    <RootNamespace>FireBirdConfigTool</RootNamespace>
    <ApplicationTitle>FireBird Config Tool</ApplicationTitle>
    <ApplicationIcon>assets\icon.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2957.106" />
  </ItemGroup>

  <ItemGroup>
    <!-- Older copies of this project may contain a stale Program.cs with a second Main().
         WPF generates the application entry point from App.xaml, so exclude that file. -->
    <Compile Remove="Program.cs" />
    <Resource Include="assets\icon.ico" />
    <Resource Include="assets\fb_icon.png" />
  </ItemGroup>


</Project>
